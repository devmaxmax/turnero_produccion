line-height: 20px;
}

.wfot h4 {
text-align: left;
font-family: 'Roboto', arial;
font-weight: 400;
color: #ababab;
font-size: 13px;
text-decoration: none;
margin: 0px;
line-height: 20px;
}



.service-e_estudio {
background: #ffffff;
margin: 10px auto 50px;
border: 0px solid #e1e1e1;
padding: 40px 20px 30px 20px;
-webkit-transition: -webkit-box-shadow 0.3s ease 0s;
transition: -webkit-box-shadow 0.3s ease 0s;
transition: box-shadow 0.3s ease 0s;
transition: box-shadow 0.3s ease 0s, -webkit-box-shadow 0.3s ease 0s;
-webkit-box-shadow: 0px 0px 15px 0px rgba(225,225,225,1);
-moz-box-shadow: 0px 0px 15px 0px rgba(225,225,225,1);
box-shadow: 0px 0px 15px 0px rgba(225,225,225,1);
position: relative;
border-radius: 10px;
}

.service-e_estudio:hover {


-webkit-box-shadow: 0px 0px 15px 0px rgba(215,215,215,1);
-moz-box-shadow: 0px 0px 15px 0px rgba(215,215,215,1);
box-shadow: 0px 0px 15px 0px rgba(215,215,215,1);
}

@media (min-width: 992px) {
  .service-e_estudio {
    margin: 0px auto 80px;
    min-height: 120px;

  }
}


@media only screen and (max-width: 990px) {

  .service-e_estudio {
    min-height: 100px;
  }
}

