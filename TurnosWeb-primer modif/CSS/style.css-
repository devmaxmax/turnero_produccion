.logo-group {
    overflow: hidden;
    padding: 0;
    border: 0px solid #ddd;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-right-style: solid;
    border-bottom-style: solid;
    border-right-color: rgb(221, 221, 221);
    border-bottom-color: rgb(221, 221, 221);
    border-right: none;
    border-bottom: none;
    position: relative;
    margin-top: 10px;
}


