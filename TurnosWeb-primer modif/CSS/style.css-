    max-width: 460px;
    min-height: 20px;
    padding: 25px 20px 25px;
    margin: 20px auto 10px;
    background-color: #f5f5f5;
    border: 2px solid #e3e3e3;
    border-radius: 10px;
}


 .parallaxwidge {
  background:url(../img/img3.jpg); /* pongo el  fondo */
  background-repeat:no-repeat; /* indico que no se repetira */
  background-size:cover; /* Encajamos la imagen al 100% del ancho */
  background-attachment: fixed; /* pongo posicion fija para la imagen */
  background-position: 50% 50%;
  line-height:20px;
  height: 200px;
  padding: 0px;
  margin-top: 20px;
  margin-bottom: 20px;
}

.widge {
  margin: 20px auto;
  border: 1px solid #e1e1e1;
  padding: 20px;
  min-height: 180px;
  background: #f0f0f0;
}

.widge2 {
  margin: 10px auto;
  border: 0px solid #e1e1e1;
  padding: 20px;
  min-height: 180px;

}

.widge2 h3,
.widge h3 {
color:#2f333a;
font-size: 1.714em;
line-height: 1.5;
text-align: left;
font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif;
font-weight: 300;
font-size: 34px;
text-transform: none;
}

.widge2 p,
.widge p {
font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif;
text-align: left;
font-size: 18px;
font-weight: 300;
line-height: 32px;
color:#555;
margin-top: 15px;

}


@media only screen and (max-width: 760px) {

  .parallaxwidge {

    height: 340px;

  }


  .widge2 h3 {

    color:#2f333a;
    font-size: 1.714em;
    line-height: 1.2;
    text-align: center;
    font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif;
    font-weight: 300;
    font-size: 26px;
    text-transform: none;
    margin-top: 10px;
  }

  .widge2 p {
    font-family: 'Roboto', 'Helvetica Neue', Arial, sans-serif;
    text-align: center;
    font-size: 14px;
    font-weight: 300;
    line-height: 26px;
    color:#555;
    margin-top: 5px;
  }

}


.box_sfooti-f {
    padding: 4px;
    border-radius: 0%;
    width: 20px;
    height: 30px;
    text-align: center;
    border: 0px solid #e1e1e1;
    display: inline;
    float: left;
    margin: 0px 8px 0px 0px;
    text-align: center;
}

.box_sfooti-f i {
    color: 
    #a4a4a4;
    margin: auto;
}

.masonry { /* Masonry container */
  column-count: 3;
  -webkit-column-count: 3; /* Safari and Chrome */
  column-gap: 1em;
  -webkit-column-gap: 1em;
  margin-top: 10px;
  margin-bottom: 30px;
}

.masonry-h { /* Masonry bricks or child elements */
  -webkit-column-break-inside: avoid;
  page-break-inside: avoid;
  break-inside: avoid;
  margin: 0 0 1em;
  display: inline-grid;
}

@supports (break-inside: avoid-column) {
  .masonry-h  {
    display: block;
  }
}

@media (max-width: 768px) {
  .masonry { /* Masonry container */
    column-count: 1;
    -webkit-column-count: 1; /* Safari and Chrome */
    column-gap: 1em;
    -webkit-column-gap: 1em;
    margin-top: 10px;
    margin-bottom: 30px;
  }
}

/*Flecha para hacer la pagina hacia arriba*/
.btn-whatsapp {
    display:block;
    width:72px;
    height:72px;
    color:#fff;
    position: fixed;
    right:20px;
    bottom:20px;
    border-radius:50%;
    line-height:0px;
    text-align:center;
    z-index:999;
}

.wfoi {
padding: 10px;
border-radius: 50%;
width: 40px;
height: 40px;
text-align: center;
border: 0px solid #e1e1e1;
margin: 0px 0px 0px 0px;
background-color: #41484e;
}

.wfoi i {
    color: #a4a4a4;
    font-size: 20px;
}

.wfot h3 {
text-align: left;
font-family: 'Roboto', arial;
font-weight: 300;
color: #ababab;
font-size: 16px;
