}

.tittle h3 {
  font-family: 'Roboto', arial;
  color:#333;
  font-size: 22px;
  font-weight: 300;
  
}

.tittle h3::before {
    content: "";
    background: #42a5f5;
    width: 25px;
    height: 1px;
    position: absolute;
    bottom: 0;
}

.service-box1 {

